#!/usr/bin/env python3
"""Stand-in for `claude -p` in the tests of 3-extract.sh.

Reads the transcript on stdin and finds the episode by its "# video_id:" line. What it does for
that episode comes from $MOCK_DIR/<video_id>.json, all keys optional:

    {"sleep": 5, "exit": 1, "stdout": "raw output", "entries": [...]}

It sleeps first, then prints "stdout" if given, otherwise {"entries": <entries>} (one valid
entry by default), and exits with "exit" (0 by default). Each call appends "start <id>" and,
if it isn't killed first, "end <id>" to $MOCK_DIR/log.
"""
import json
import os
import re
import sys
import time

mock_dir = os.environ["MOCK_DIR"]
transcript = sys.stdin.read()
vid = re.search(r"^# video_id: (\S+)", transcript, re.M).group(1)


def log(event):
    with open(os.path.join(mock_dir, "log"), "a", encoding="utf-8") as f:
        f.write(f"{event} {vid}\n")


log("start")
path = os.path.join(mock_dir, f"{vid}.json")
spec = json.load(open(path, encoding="utf-8")) if os.path.exists(path) else {}
time.sleep(spec.get("sleep", 0))
if "stdout" in spec:
    sys.stdout.write(spec["stdout"])
else:
    entries = spec.get("entries", [{"term": "word", "timestamp": "00:00:00", "role": "subject",
                                    "note": "A word.", "confidence": "high"}])
    json.dump({"entries": entries}, sys.stdout)
sys.stdout.flush()
log("end")
sys.exit(spec.get("exit", 0))
